# Salin file ini menjadi .env.local
#
# PENTING: pakai NILAI YANG SAMA PERSIS dengan project "yayasan-app",
# karena aplikasi kiosk ini terhubung ke project Supabase yang sama
# (Project Settings > API di dashboard Supabase yang sama).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Tidak perlu SUPABASE_SERVICE_ROLE_KEY di aplikasi ini.
# Kiosk ini sengaja HANYA memakai anon key + login akun
# "petugas_absensi", supaya semua akses data tunduk pada
# Row Level Security (lihat supabase/schema-absensi-kiosk-v1b.sql).
